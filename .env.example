# SEA:NIOR 환경 변수 예시 파일
# 실제 환경 변수 값은 절대 Git에 커밋하지 말고 .env.local 및 Vercel 프로젝트 환경 설정에 입력하세요.

# 1. Supabase 프로젝트 URL (예: https://your-project-ref.supabase.co)
SUPABASE_URL=

# 2. Supabase Service Role Key (주의: 브라우저에 절대 노출되면 안 되는 서버 전용 비밀키입니다)
SUPABASE_SERVICE_ROLE_KEY=

# 3. Supabase Storage 버킷 이름 (기본값: seanior-media)
SUPABASE_STORAGE_BUCKET=seanior-media

# 4. (선택) 서비스 기본 URL
APP_URL=http://localhost:3000
